@model TireDrift.Models.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "Добавяне на доставчик";
}
@section Styles {
    <link rel="stylesheet" href="~/css/forms/form.css" asp-append-version="true" />
}
<section class="login-register-container">
    <div class="form-container the-container">
        <form asp-action="AddSupplier" enctype="multipart/form-data">
            <h2 class="form-title">Добавяне на доставчик</h2>
            <div class="inputs-container">
                <div class="input-field">
                    <label>Име</label>
                    <input type="text" placeholder="Име" asp-for="Name">
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="input-field">
                    <label>Телефонен номер</label>
                    <input type="text" placeholder="Телефонен номер" asp-for="PhoneNumber">
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="submit-button">
                    <button class="btn btn-outline-secondary" type="submit">Добавяне на доставчик</button>
                </div>
        </form>
    </div>
</section>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}