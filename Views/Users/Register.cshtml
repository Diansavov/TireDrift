@model TireDrift.Models.ViewModels.LogInViewMode

@{
    ViewData["Title"] = "Log In";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile/login.css" asp-append-version="true" />
}

<form asp-action="LogIn">
    <div class="input-field">
        <input id="loginInput" type="text" asp-for="Username">
        <label id="loginLabel" class="form-label-login">Username</label>
    </div>
    <span asp-validation-for="Username" class="text-danger"></span>
    <div class="input-field">
        <input id="loginInput" type="password" asp-for="Password">
        <label id="loginLabel" class="form-label-login">Password</label>
    </div>
    <span asp-validation-for="Password" class="text-danger"></span>
    <div class="submit-button">
        <button type="submit" class="btn-submit">Log In</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/profile/logIn/logInTextAnimation.js"></script>
}