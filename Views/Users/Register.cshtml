@model TireDrift.Models.ViewModels.UserRegisterViewModel

@{
    ViewData["Title"] = "Регистриране";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile/register.css" asp-append-version="true" />
}
<section class="login-section">
    <div class="wrapper">
        <form asp-action="Register">
            <h2>Регистриране</h2>
            <div class="split-inputs-container">
                <div class="input-field">
                    <input type="text" asp-for="FirstName" required>
                    <label>Лично име</label>
                </div>
                <div class="input-field">
                    <input type="text" asp-for="LastName" required>
                    <label>Фамилно име</label>
                </div>
            </div>
            <div class="input-field">
                <input type="text" asp-for="UserName" required>
                <label>Потребителско име</label>
            </div>
            <div class="input-field">
                <input type="password" asp-for="Password" required>
                <label>Парола</label>
            </div>
            <div class="input-field">
                <input type="email" asp-for="Email" required>
                <label>Имейл</label>
            </div>
            <div class="input-field">
                <input type="text" asp-for="PhoneNumber" required>
                <label>Телефонен номер</label>
            </div>
            <button class="btn login-button" type="submit">Регистриране</button>
            <div class="register">
                <p>Имате акаунт? <a asp-controller="Users" asp-action="LogIn">Влез!</a></p>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/profile/logIn/logInTextAnimation.js"></script>
}