<section class="login-section">
    <div class="wrapper">
        <form asp-action="LogIn">
            <h2>Влизане</h2>
            <div class="input-field">
                <input type="text" asp-for="UserName" required>
                <label>Потребителско име</label>
            </div>
            <div class="input-field">
                <input type="password" asp-for="Password" required>
                <label>Парола</label>
            </div>
            <button class="btn login-button"type="submit">Влизане</button>
            <div class="register">
                <p>Нямате акаунт? <a asp-controller="Users" asp-action="Register">Регистрирайте се!</a></p>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/profile/logIn/logInTextAnimation.js"></script>
    <partial name="_ValidationScriptsPartial" />
}