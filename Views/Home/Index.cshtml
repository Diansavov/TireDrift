@{
	ViewData["Title"] = "Home Page";
}
<section id="home" class="welcome-hero">
	<div class="container hero-container">
		<div class="welcome-hero-txt">
			<h2>Място за продажба <br> и обслужване на гуми </h2>
		</div>
		<div class="welcome-hero-serch-box">
			<form action="index.html" class="search-form">
				<div class="welcome-hero-form">
					<div class="single-welcome-hero-form">
						<h3>Търсите гуми?</h3>
						<input type="text" placeholder="напр: Мишелин, Гудиър, Бриджстоун" />
						<div class="welcome-hero-form-icon">
							<i class="flaticon-list-with-dots"></i>
						</div>
					</div>
					<button class="welcome-hero-btn">
						Търсене <i class="bi bi-search search-icon"></i>
					</button>
				</div>
			</form>
		</div>
	</div>
</section>

<!--list-topics start -->
<section id="list-topics" class="list-topics">
	<div class="container redirect-buttons">
		<div class="list-topics-content">
			<ul>
				<li>
					<div class="single-list-topics-content">
						<div class="single-list-topics-icon">
							<img src="~/images/images/tire.png" alt="Category Thumbnail">
						</div>
						<h2><a href="#">Видове гуми</a></h2>
						<p>150 listings</p>
					</div>
				</li>
				<li>
					<div class="single-list-topics-content">
						<div class="single-list-topics-icon">
							<img src="~/images/images/service.png" alt="Category Thumbnail">
						</div>
						<h2><a href="#">Услуги</a></h2>
						<p>4 избора</p>
					</div>
				</li>
				<li>
					<div class="single-list-topics-content">
						<div class="single-list-topics-icon">
							<img src="~/images/images/tireRack.png" alt="Category Thumbnail">
						</div>
						<h2><a href="#">Хотел за гуми</a></h2>
						<p>0 ваши гуми</p>
					</div>
				</li>
			</ul>
		</div>
	</div>

</section>
<!--list-topics end-->

<!--user stuff start -->
<section id="works" class="works">
	<div class="container">
		<div class="works-content">
			<div class="col-md-4 col-sm-6">
				<div class="single-how-works">
					<div>
						<div class="single-how-works-icon">
							<i class="bi bi-truck single-how-works-icon"></i>
						</div>

						<h2>Преглеждайте поръчките си</h2>
						<p>
							Може да преглеждайте поръчките си и контактната информация на доставчиците им.
						</p>
					</div>
					<button class="welcome-hero-btn how-work-btn" onclick="window.location.href='#'">
						Поръчки
					</button>
				</div>
			</div>
			<div class="col-md-4 col-sm-6">
				<div class="single-how-works">
					<div>
						<div class="single-how-works-icon">
							<i class="bi bi-receipt single-how-works-icon"></i>
						</div>
						<h2>Фактури</h2>
						<p>
							Ние осигуряваме простота и ефективност в процеса на фактуриране, като ви помагаме да
							спестите време и усилия, издаваме финансовите документи.
						</p>
					</div>
					<button class="welcome-hero-btn how-work-btn" onclick="window.location.href='#'">
						Фактури
					</button>
				</div>
			</div>
		</div>
	</div>

</section>
<!--works end -->

