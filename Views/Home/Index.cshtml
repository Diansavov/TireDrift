@model List<Tire>

@{
	ViewData["Title"] = "Начална страница";
}

<section id="home" class="welcome-hero">
	<div class="container hero-container">
		<div class="welcome-hero-txt">
			<h2>Място за продажба <br> и обслужване на гуми </h2>
		</div>
		<div class="welcome-hero-serch-box">
			<form asp-controller="Tires" asp-action="Tires" class="search-form">
				<div class="welcome-hero-form">
					<div class="single-welcome-hero-form">
						<h3>Търсите гуми?</h3>
						<input type="text" name="name" placeholder="напр: Мишлен, Гудиър, Бриджстоун" />
						<div class="welcome-hero-form-icon">
							<i class="flaticon-list-with-dots"></i>
						</div>
					</div>
					<button class="welcome-hero-btn">
						Търсене <i class="bi bi-search search-icon"></i>
					</button>
				</div>
			</form>
		</div>
	</div>
</section>

<!--list-topics start -->
<section id="list-topics" class="list-topics">
	<div class="container redirect-buttons">
		<div class="list-topics-content">
			<ul>
				<li>
					<a asp-controller="Tires" asp-action="Tires" class="single-list-topics-content">
						<div class="single-list-topics-icon">
							<img src="~/images/images/tire.png" alt="Category Thumbnail">
						</div>
						<h2><span>Видове гуми</span></h2>
						<p>@Model.Count вида</p>
					</a>
				</li>
				<li>
					<a asp-controller="Tires" asp-action="Services" class="single-list-topics-content">
						<div class="single-list-topics-icon">
							<img src="~/images/images/service.png" alt="Category Thumbnail">
						</div>
						<h2><span>Услуги</span></h2>
						<p>4 избора</p>
					</a>
				</li>
				<li>
					<a asp-controller="Tires" asp-action="TireHotel" class="single-list-topics-content">
						<div class="single-list-topics-icon">
							<img src="~/images/images/tireRack.png" alt="Category Thumbnail">
						</div>
						<h2><span>Хотел за гуми</span></h2>
						<p><span id="user-hotel-tires"></span> ваши гуми</p>
					</a>
				</li>
			</ul>
		</div>
	</div>

</section>
<!--list-topics end-->

<!--user stuff start -->
<section id="works" class="works">
	<div class="container">
		<div class="works-content">
			<a class="col-md-4 col-sm-6" asp-controller="Order" asp-action="Orders">
				<div class="single-how-works">
					<div>
						<div class="single-how-works-icon">
							<i class="bi bi-bag-check-fill single-how-works-icon"></i>
						</div>

						<h2>Преглеждайте поръчките си</h2>
						<p>
							Може да преглеждайте поръчките си и контактната информация на доставчиците им.
						</p>
					</div>
					<button class="welcome-hero-btn how-work-btn">
						Поръчки
					</button>
				</div>
			</a>
			<a class="col-md-4 col-sm-6" asp-controller="Order" asp-action="Invoices">
				<div class="single-how-works">
					<div>
						<div class="single-how-works-icon">
							<i class="bi bi-receipt single-how-works-icon"></i>
						</div>
						<h2>Фактури</h2>
						<p>
							Ние осигуряваме простота и ефективност в процеса на фактуриране, като ви помагаме да
							спестите време и усилия, издаваме финансовите документи.
						</p>
					</div>
					<button class="welcome-hero-btn how-work-btn" onclick="window.location.href='#'">
						Фактури
					</button>
				</div>
			</a>
		</div>
	</div>

</section>
<!--works end -->
<!-- statistics strat -->
<section id="statistics" class="statistics">
	<div class="container stats-container">
		<div class="statistics-counter">
			<div class="col-md-3 col-sm-6">
				<div class="single-ststistics-box">
					<div class="statistics-content">
						<span class="counter">@Model.Count</span>
					</div>
					<h3>Вида гуми</h3>
				</div>
			</div>
			<div class="col-md-3 col-sm-6">
				<div class="single-ststistics-box">
					<div class="statistics-content">
						<span class="counter">4</span>
					</div>
					<h3>вида услуги</h3>
				</div>
			</div>
			<div class="col-md-3 col-sm-6">
				<div class="single-ststistics-box">
					<div class="statistics-content">
						<span class="counter">1250+</span>
					</div>
					<h3>Посетителя</h3>
				</div>
			</div>
			<div class="col-md-3 col-sm-6">
				<div class="single-ststistics-box">
					<div class="statistics-content">
						<span class="counter">1000+</span>
					</div>
					<h3>Доволни Клиента</h3>
				</div>
			</div>
		</div>
	</div>

</section>
<!-- statistics end -->
<!--explore start -->
<section id="explore" class="explore">
	<div class="container">
		<div class="section-header">
			<h2>Популярни гуми</h2>
		</div>
		<!--/.section-header-->
		<div class="explore-content">
			<div class="row">
				@for (int i = 0; i < (Model.Count > 5 ? 5 : Model.Count); i++)
				{
					<!-- Card -->
					<div class="col-md-4 col-sm-6">
						<div class="single-explore-item">
							<div class="single-explore-img">
								<img src="@Model[i].ImagePath" alt="explore image">
								@if (Model[i].Orders.Count > 3)
								{
									<div class="single-explore-img-info">
										<span>Популярен</span>
									</div>
								}
							</div>
							<div class="single-explore-txt bg-theme-1">
								<h2>@Model[i].Name</h2>
								<p class="explore-rating-price">
									<span>@Model[i].Stock бр. стока</span>
									<span class="explore-price-box">
										<span class="explore-price">@Math.Round(Model[i].Price, 2) лв.</span>
									</span>
								</p>
								<div class="explore-person">
									<div class="row">
										<div class="col-sm-10">
											<p>
												@Model[i].Description
											</p>
										</div>
									</div>
								</div>
								<div class="explore-open-close-part">
									<form asp-controller="Cart" asp-action="AddTireToCartIndex">
										<div class="row card-buying">
											<div class="col-sm-5">
												<input class="form-control" name="quantity" type="number" min="1"
													max="@Model[i].Stock" value="1">
												<input hidden name="id" value="@Model[i].Id">
											</div>
											<div class="col-sm-5">
												<button type="submit" class="btn">Добави в количка</button>
											</div>
										</div>
									</form>
								</div>
							</div>
						</div>
					</div>
					<!-- Card End-->
				}

			</div>
		</div>
	</div>
</section>
<!--explore end -->

@section Scripts {
	<script src="~/js/assets/counter.js"></script>
	@if (User.Identity.IsAuthenticated)
	{
		<script src="~/js/orders/user-invoices-count.js"></script>
	}
	else
	{
		<script>
			document.getElementById('user-hotel-tires').innerHTML = 0; // Handle the successful response
		</script>
	}
}