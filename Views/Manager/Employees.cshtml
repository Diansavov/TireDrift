@{
    ViewData["Title"] = "Всички потребители";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/datatables.min.css" />
    <script src="~/lib/datatables/datatables.min.js"></script>
    <script src="~/js/employees/employees-datatable.js"></script>

}
<section class="section-container">
    <div class="container-text text-title">
        <h1>Всички потребители</h1>
    </div>
    <form id="search-form">
        <div class="search-names-container bg-light">
            <div class="search-names">
                <input type="text" name="firstName" class="form-control border-0 bg-transparent"
                    placeholder="Лично име" />
            </div>
            <div class="col-1 search-icon-container">
                <a type="submit" onclick="searchSubmit(); return false;">
                    <i class="bi bi-search search-icon"></i>
                </a>
            </div>
        </div>
    </form>
    <div class="users-container">
        <table id="usersTable" class="table">
            <thead>
                <tr class="thead-row">
                    <th>Потребителско име</th>
                    <th>Роля</th>
                    <th>Имейл</th>
                    <th>Лично име</th>
                    <th>Фамилно име</th>
                    <th>Телефонен номер</th>
                    <th>Действия</th>
                </tr>
            </thead>
        </table>
    </div>
</section>

@section Scripts {

}