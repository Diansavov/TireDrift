@{
    ViewData["Title"] = "Всички потребители";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/datatables.min.css" />
    <script src="~/lib/datatables/datatables.min.js"></script>
    <link rel="stylesheet" href="~/css/table/table.css" />


}

<section class="section-table">
    <div class="section-header">
        <h2>Всички доставчици</h2>
    </div>
    <div class="table-search">
        <form id="search-form">
            <div class="single-welcome-hero-form bg-light">
                <input type="text" name="firstName" placeholder="Лично име" />
                <div class="welcome-hero-form-icon">
                    <i class="flaticon-list-with-dots"></i>
                </div>
                <button class="welcome-hero-btn" onclick="searchSubmit(); return false;">
                    Търсене <i class="bi bi-search search-icon"></i>
                </button>
            </div>
        </form>
    </div>
    <div class="users-container">
        <table id="usersTable" class="table">
            <thead>
                <tr class="thead-row">
                    <th>Лично име</th>
                    <th>Фамилно име</th>
                    <th>Потребителско име</th>
                    <th>Роля</th>
                    <th>Имейл</th>
                    <th>Телефонен номер</th>
                </tr>
            </thead>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/js/employees/employees-datatable.js"></script>

}