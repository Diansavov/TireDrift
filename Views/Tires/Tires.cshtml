@model List<Tire>

@{
    ViewData["Title"] = "Tires";
}

All Tires
<a class="btn btn-success" asp-controller="Tires" asp-action="AddTire">Add Tire</a>

<form asp-controller="Tires" asp-action="Tires">

    <input type="text" name="name" />
    <select name="filter">
        <option class="fw-bold" value="name">Име</option>
        <option class="fw-bold" value="-name">Име (низходящо)</option>
        <option class="fw-bold" value="stock">Стока</option>
        <option class="fw-bold" value="-stock">Стока (низходяща)</option>
        <option class="fw-bold" value="price">Цена</option>
        <option class="fw-bold" value="-price">Цена (низходяща)</option>
    </select>
    <button class="btn btn-success" type="submit">Search</button>
</form>
<div style="display: flex;">
    @foreach (var tire in Model)
    {
        <div style="display: flex; flex-direction: column;">

            <div style="display: flex; width: 200px; height: 200px;">
                <img src="@tire.ImagePath"></img>
            </div>
            <div>
                <span>@tire.Name</span>
            </div>
            <div>
                <span>@tire.Description</span>
            </div>
            <div>
                <span>@Math.Round(tire.Price, 2)</span>
            </div>
            <div>
                <a class="btn btn-success" asp-controller="Cart" asp-action="AddTireToCart" asp-route-id="@tire.Id">Buy</a>
            </div>
            <div>
                <a asp-controller="Tires" asp-action="EditTire" asp-route-id="@tire.Id" class="btn btn-warning">Edit</a>
            </div>
            <div>
                <a asp-controller="Tires" asp-action="DeleteTire" asp-route-id="@tire.Id" class="btn btn-danger">Del</a>
            </div>
        </div>
    }
</div>

@section Scripts{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var selectedFilter = '@ViewData["filter"]';
            if (selectedFilter) {
                var selectElement = document.querySelector('select[name="filter"]');
                if (selectElement) {
                    selectElement.value = selectedFilter;
                }
            }
        });
    </script>
}