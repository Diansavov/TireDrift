@model List<HotelTires>
@{
    ViewData["Title"] = "Хотел за гуми";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tires/tires.css">
    <link rel="stylesheet" href="~/css/tires/hotel-tire.css">
}
<section id="home" class="welcome-hero-tires">
    <div class="container hero-container">
        <div class="welcome-hero-txt">
            <h2><span class="bmw-color">Хотелът В</span>и за Гуми </h2>
        </div>

    </div>
</section>
<section id="list-topics" class="search-tires">
    <div class="container redirect-buttons">
        <div class="welcome-hero-form">
            <a asp-controller="Tires" asp-action="AddTireToHotel" class="welcome-hero-btn w-100">
                Добавяне на гума В хотела
            </a>
        </div>
    </div>
</section>
<section id="explore" class="explore">
    <div class="container">
        <div class="section-header discount-field">
            <h2 id="discount-outer">Получавате намаление от покупката на нови гуми в зависимост от количеството гуми в
                хотелът ви: <span id="discount">@ViewData["Discount"]</span>% (до -25%)</h2>
        </div>
         <div class="section-header">
            <h2 id="discount-outer">Цена за съхранение на една гума (за 6 месеца): 12лв.</h2>
        @if(Model.Count > 0){   
            <h2 id="discount-outer">Заплащате: @(Model.Sum(x => x.TireQuanity) * 12)лв. всеки 6 месеца</h2>
        }
        </div>
        
        <!--/.section-header-->
        <div class="explore-content">
            <div class="row">
                @foreach (HotelTires tire in Model)
                {
                    <!-- Card -->
                    <div class="col-md-4 col-sm-6">
                        <div class="single-explore-item">
                            <div class="single-explore-img">
                                <img src="@tire.TireImageUrl" alt="explore image">
                            </div>
                            <div class="single-explore-txt bg-theme-1">
                                <h2>@tire.TireName</h2>
                                <p class="explore-rating-price">
                                    <span>@tire.TireQuanity бр. в хотелът</span>
                                </p>
                                <div class="explore-open-close-part">
                                    <div class="row card-buying">
                                        <a type="submit" asp-controller="Tires" asp-action="RemoveTireFromHotel"
                                            asp-route-id="@tire.Id" class="btn">Премахни</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Card End-->
                }

            </div>
        </div>
    </div>
</section>
@section Scripts {
    @if ((int)(ViewData["Discount"]) == 0)
    {
        <script>
            document.getElementById('discount-outer').innerHTML = "Трябва над 5 гуми в хотелът за отстъпка. Всяка гума след това е по 1% отстъпка до 25%"
        </script>
    }
}