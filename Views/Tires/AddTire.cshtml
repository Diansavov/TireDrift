@model TireDrift.Models.ViewModels.TireViewModel

@{
    ViewData["Title"] = "Добавяне на гума";
}
@section Styles{
    <link rel="stylesheet" href="~/css/forms/form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms/bigger-form.css" asp-append-version="true" />
}

<section class="login-register-container">
    <div class="form-container the-container">
        <form asp-action="AddJewelry" enctype="multipart/form-data">
            <h2 class="form-title">Добавяне на бижу</h2>
            <div class="inputs-container">
                    <div class="input-field">
                        <label>Снимка</label>
                        <input id="image-input" class="image-input" accept="image/png" type="file" asp-for="Image">
                        <span asp-validation-for="Image" class="text-danger"></span>
                    </div>
                    <div class="input-field">
                        <input type="text" placeholder="Цена" asp-for="Price">
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="submit-button">
                        <button class="btn btn-primary" type="submit">Добавяне на бижу</button>
                    </div>
        </form>
    </div>
</section>
