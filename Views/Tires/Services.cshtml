@model List<Service>

@{
    ViewData["Title"] = "Услуги";
}
@section Styles {
    <link rel="stylesheet" href="~/css/tires/services.css" asp-append-version="true" />
}


<section id="home" class="welcome-hero-tires">
    <div class="container hero-container">
        <div class="welcome-hero-txt">
            <h2>Всичк<span class="bmw-color">и Услуги</span></h2>
        </div>

    </div>
</section>
<section id="list-topics" class="search-tires">
    <div class="container redirect-buttons">
            @foreach (var service in Model)
            {
					<!-- Card -->
					<div class="col-md-4 col-sm-6">
						<div class="single-explore-item">
							<div class="single-explore-img">
								<img src="@service.ImagePath" alt="explore image">
							</div>
							<div class="single-explore-txt bg-theme-1">
								<h2>@service.Name</h2>
								<p class="explore-rating-price">
									<span class="explore-price-box">
										<span class="explore-price">@Math.Round(service.Price, 2) лв.</span>
									</span>
								</p>
								<div class="explore-person">
									<div class="row">
										<div class="col-sm-10">
											<p>
												@service.Description
											</p>
										</div>
									</div>
									@if (User.IsInRole("Manager") || User.IsInRole("Technician"))
									{
										<a asp-controller="Tires" asp-action="EditService" asp-route-id="@service.Id" type="submit" class="btn">Редактиране</a>
									}
								</div>
								<div class="explore-open-close-part">
									<form asp-controller="Cart" asp-action="AddServiceToCart">
										<div class="row card-services">
											<div class="col-sm-5">
												<input hidden name="id" value="@service.Id">
												<button type="submit" class="btn">Добави в количка</button>
											</div>
										</div>
									</form>
								</div>
							</div>
						</div>
					</div>
					<!-- Card End-->
				}
    </div>
</section>