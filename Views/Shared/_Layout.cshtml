<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TireDrift.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons-1.11.3/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/node_modules/toastr/build/toastr.min.css" asp-append-version="true" />

    <link
        href="https://fonts.googleapis.com/css?family=Poppins:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">


    <link rel="stylesheet" href="~/css/assets/font-awesome.min.css">

    <link rel="stylesheet" href="~/css/assets/linearicons.css">
    <link rel="stylesheet" href="~/css/assets/animate.css">
    <link rel="stylesheet" href="~/css/assets/flaticon.css">
    <link rel="stylesheet" href="~/css/assets/slick.css">
    <link rel="stylesheet" href="~/css/assets/slick-theme.css">
    <link rel="stylesheet" href="~/css/assets/bootsnav.css">
    <link rel="stylesheet" href="~/css/assets/style.css">
    <link rel="stylesheet" href="~/css/assets/responsive.css">

    <script src="~/lib/jquery/dist/jquery.js" asp-append-version="true"></script>

    @RenderSection("Styles", false)
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white box-shadow ">
            <div class="container-fluid container-navbar">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">TireDrift</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 nav-bar-flex-container">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                                asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Tires"
                                asp-action="Tires">Tires</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Tires"
                                asp-action="Services">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Manager"
                                asp-action="ManagerPanel">Manager Panel</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Cart" asp-action="Cart">Cart</a>
                        </li>
                    </ul>
                    <div class="d-flex gap-2">
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <a class="btn btn-outline-success" asp-area="" asp-controller="Users" asp-action="LogIn"
                                type="submit">Log In</a>
                            <a class="btn btn-success" asp-area="" asp-controller="Users" asp-action="Register"
                                type="submit">Register</a>
                        }
                        else
                        {
                            <div class="justify-content-center">
                                <a class="btn btn-outline-success" asp-area="" asp-controller="Users" asp-action="LogOut"
                                    type="submit">Log Out</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <!-- top-area Start -->
    <section class="top-area">
        <div class="header-area">
            <!-- Start Navigation -->
            <nav class="navbar navbar-default bootsnav  navbar-sticky navbar-scrollspy" data-minus-value-desktop="70"
                data-minus-value-mobile="55" data-speed="1000">

                <div class="container">

                    <!-- Start Header Navigation -->
                    <div class="navbar-header">
                        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#navbar-menu">
                            <i class="fa fa-bars"></i>
                        </button>
                        <a class="navbar-brand" href="index.html">list<span>race</span></a>

                    </div><!--/.navbar-header-->
                    <!-- End Header Navigation -->

                    <!-- Links -->
                    <div class="collapse navbar-collapse menu-ui-design" id="navbar-menu">
                        <ul class="nav navbar-nav navbar-right" data-in="fadeInDown" data-out="fadeOutUp">
                            <li class=" scroll active"><a href="#home">home</a></li>
                            <li class="scroll"><a href="#works">how it works</a></li>
                            <li class="scroll"><a href="#explore">explore</a></li>
                            <li class="scroll"><a href="#reviews">review</a></li>
                            <li class="scroll"><a href="#blog">blog</a></li>
                            <li class="scroll"><a href="#contact">contact</a></li>
                        </ul>
                    </div>
                </div>
            </nav>
            <!-- End Navigation -->
        </div>
        <div class="clearfix"></div>

    </section>
    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - TireDrift - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_Notification" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/modernizr/2.8.3/modernizr.min.js"></script>
    <script src="~/js/assets/bootsnav.js"></script>
    <script src="~/js/assets/feather.min.js"></script>
    <script src="~/js/assets/jquery.counterup.min.js"></script>
    <script src="~/js/assets/waypoints.min.js"></script>
    <script src="~/js/assets/slick.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.4.1/jquery.easing.min.js"></script>

    <!--Custom JS-->
    <script src="assets/js/custom.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
