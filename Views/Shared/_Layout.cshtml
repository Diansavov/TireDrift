<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TireDrift.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons-1.11.3/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/node_modules/toastr/build/toastr.min.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap"
        rel="stylesheet">



    <link rel="stylesheet" href="~/css/assets/font-awesome.min.css">

    <link rel="stylesheet" href="~/css/assets/linearicons.css">
    <link rel="stylesheet" href="~/css/assets/animate.css">
    <link rel="stylesheet" href="~/css/assets/slick.css">
    <link rel="stylesheet" href="~/css/assets/slick-theme.css">
    <link rel="stylesheet" href="~/css/assets/style.css">
    <link rel="stylesheet" href="~/css/assets/responsive.css">

    <script src="~/lib/node_modules/jquery/dist/jquery.min.js"></script>

    @RenderSection("Styles", false)
</head>

<body>
    <header>
        <nav id="nav-bar" class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white box-shadow ">
            <div class="container-fluid container-navbar">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">TireDrift</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 nav-bar-flex-container">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Начална
                                страница</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Tires" asp-action="Tires">Гуми</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Tires"
                                asp-action="Services">Услуги</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Manager"
                                asp-action="ManagerPanel">Панел на мениджър</a>
                        </li>
                    </ul>
                    <div class="d-flex gap-2">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Cart"
                                asp-action="Cart"><i class="bi bi-cart-fill cart-icon"></i></a>
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <a class="btn btn-outline-secondary" asp-area="" asp-controller="Users" asp-action="LogIn"
                                type="submit">Влизане</a>
                            <a class="btn btn-secondary" asp-area="" asp-controller="Users" asp-action="Register"
                                type="submit">Регистриране</a>
                        }
                        else
                        {
                            <div class="justify-content-center">
                                <a class="btn btn-outline-secondary" asp-area="" asp-controller="Users" asp-action="LogOut"
                                    type="submit">Излизане</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3 content">
        <div class="content-inside">
            @RenderBody()
        </div>
    </main>

    <!--footer start-->
    <footer id="footer" class="footer">
        <div class="container">
            <div class="footer-menu">
                <div class="row">
                    <div class="col-sm-3">
                        <div class="navbar-header">
                            <a class="navbar-brand" href="#nav-bar">TireDrift</a>
                        </div>
                    </div>
                    <div class="col-sm-9">
                        <ul class="footer-menu-item">
                            <li class="scroll"><a href="#nav-bar">Начална страница</a></li>
                            <li class="scroll"><a asp-controller="Tires" asp-action="Tires">Гуми</a></li>
                            <li class="scroll"><a asp-controller="Tires" asp-action="Services">Услуги</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div id="scroll-Top">
            <div class="return-to-top">
                <i class="bi bi-arrow-up" id="scroll-top" data-toggle="tooltip" data-placement="top" title=""
                    data-original-title="Back to Top" aria-hidden="true"></i>
            </div>
        </div>

    </footer>

    <partial name="_Notification" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/assets/slick.min.js" asp-append-version="true"></script>

    <script src="~/lib/node_modules/counterup2/dist/index.js"></script>
    <!--Custom JS-->
    <script src="~/js/assets/custom.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
